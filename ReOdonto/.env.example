# ============================================================
# ReOdonto — Variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais
# NUNCA commite o .env com valores reais no git
# ============================================================

# Chave secreta do Flask (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria-forte

# Chave secreta para assinar os tokens JWT (HS256)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-outra-chave-aleatoria-forte

# Chave de criptografia Fernet para PII (AES-128-CBC)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gere-uma-chave-fernet-valida

# Sem SECRET_KEY / JWT_SECRET_KEY o backend gera chaves aleatórias a cada
# execução (os logins caem a cada reinício). Sem ENCRYPTION_KEY, os dados de
# paciente gravados antes deixam de ser legíveis. Defina as três.

# Habilitar modo debug do Flask (nunca True em produção)
FLASK_DEBUG=false

# Banco de dados (opcional). Sem esta variável usa backend/database/odonto.db
# DATABASE_URL=sqlite:////caminho/absoluto/odonto.db

# ============================================================
# Google OAuth2 — Autenticação
# ============================================================
# Obtenha essas credenciais em: https://console.cloud.google.com
# 1. Crie um novo projeto
# 2. Ative a API "Google+ API"
# 3. Crie credenciais OAuth 2.0 (Web application)
# 4. Configure as URIs autorizadas:
#    - URIs autorizados: http://localhost:5000
#    - URIs de redirecionamento: http://localhost:5000/auth/google/callback
# 5. Baixe o arquivo JSON e extraia os valores abaixo

GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Client IDs extras aceitos no login Google (Android/iOS), separados por vírgula.
# O GOOGLE_CLIENT_ID acima já é aceito automaticamente.
# GOOGLE_ALLOWED_CLIENT_IDS=xxx-android.apps.googleusercontent.com,yyy-ios.apps.googleusercontent.com

# ============================================================
# Email SMTP — Recuperação de Senha
# ============================================================
# Configure as variáveis abaixo para habilitar o envio de email.
# Para Gmail, use um App Password (não a senha normal):
# https://myaccount.google.com/apppasswords

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_app_password_do_gmail
MAIL_FROM=noreply@reodonto.com
